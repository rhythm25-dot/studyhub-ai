# ==============================
# Server
# ==============================
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ==============================
# MySQL Database
# ==============================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=studyhub_ai

# ==============================
# JWT
# ==============================
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ==============================
# Cloudinary (file storage)
# ==============================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==============================
# Nodemailer (email verification / password reset)
# ==============================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM="StudyHub AI <you@gmail.com>"

# ==============================
# Google Gemini AI
# ==============================
GEMINI_API_KEY=your_gemini_api_key
# Google renames/retires Gemini models periodically - if you get a 404 or
# "model not found" error, check https://ai.google.dev/gemini-api/docs/models
# for the current stable model list and update this value.
GEMINI_MODEL=gemini-3.1-flash-lite

# ==============================
# Rate Limiting
# ==============================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
